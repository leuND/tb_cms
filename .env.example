# Salin file ini menjadi .env lalu isi nilai asli. .env tidak boleh di-commit.
# Password admin bersama (dibagikan lewat chat tim, bukan lewat repo).
# Kosongkan untuk menonaktifkan login admin.
ADMIN_PASSWORD=ganti-dengan-password-tim
# Kunci sesi Flask. Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
TBCMS_DB=/home/USERNAME/tb_cms/data/tb_cms.sqlite
TBCMS_MASUK=/home/USERNAME/tb_cms/masuk
